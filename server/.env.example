# Server Port Configuration
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection URI
MONGODB_URI=mongodb://localhost:27017/agentflow_ai

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AES-256 Master Cryptographic Key (Used to encrypt OAuth tokens & Bot Webhooks at rest)
CREDENTIAL_ENCRYPTION_KEY=

# Environment Mode
NODE_ENV=development

# Optional AI LLM Keys (Falls back to Deterministic Financial Rule Engine if omitted)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional Google Workspace OAuth 2.0 Credentials (for Gmail API & Google Sheets API)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=

